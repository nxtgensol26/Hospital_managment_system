# ---------------------------------------------------------------------------
# NxtHealth environment configuration
# Copy to `.env` (or `.env.local`) and fill in. Only PUBLIC values live here.
# The Supabase service-role key and the license signing key are NEVER placed
# in the frontend — they exist only server-side (edge functions / DB secrets).
# ---------------------------------------------------------------------------

# Data backend: "local" (localStorage DEV/DEMO) or "supabase" (production)
VITE_DATA_MODE=supabase

# Supabase project (public client config only)
VITE_SUPABASE_URL=https://mcinemybxfqyrpgbnitj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Wx8QO_KCvfnK1UAAvY-a2w_8F_PMvFB

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set these as Supabase edge function secrets, NOT here:
#   supabase secrets set SMS_HORIZON_URL=... SMS_HORIZON_API_KEY=...
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#  into edge functions automatically by the platform.)
# The license signing key is stored in the private public.app_secrets table.
# ---------------------------------------------------------------------------
